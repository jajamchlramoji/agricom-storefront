{
  "name": "agricom-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:storefront": "cd frontend && vite --host 127.0.0.1",
    "dev:admin": "cd admin && vite --host 127.0.0.1",
    "dev:backend": "node scripts/dev-backend.mjs",
    "build": "cd frontend && tsc -b tsconfig.json && vite build && cd ../admin && tsc -p tsconfig.json && vite build",
    "preview": "cd frontend && vite preview --host 127.0.0.1",
    "preview:admin": "cd admin && vite preview --host 127.0.0.1 --port 4174"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  }
}
