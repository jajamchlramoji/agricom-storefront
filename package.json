{
  "name": "agricom-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:storefront": "cd frontend && vite --host 127.0.0.1",
    "dev:admin": "cd admin && vite --host 127.0.0.1",
    "dev:backend": "node scripts/dev-backend.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p frontend/tsconfig.app.json && tsc -p admin/tsconfig.json",
    "test": "node --test backend/tests/*.test.mjs",
    "build": "cd frontend && tsc -b tsconfig.json && vite build && cd ../admin && tsc -p tsconfig.json && vite build",
    "preview": "cd frontend && vite preview --host 127.0.0.1",
    "preview:admin": "cd admin && vite preview --host 127.0.0.1 --port 4174"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.4.49",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.1"
  }
}
